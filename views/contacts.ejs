<%- include('partials/header', { pageTitle: 'Контакты', active: 'contacts', breadcrumbs: [{label: 'Контакты'}] }) %>

<div class="page-header">
  <div class="hero-ledger"></div>
  <div class="container">
    <div class="kicker">Контакты</div>
    <h1>Оставьте заявку — подберём курс и группу</h1>
  </div>
</div>

<section>
  <div class="container two-col">
    <div>
      <h2 style="font-size:24px;">Заявка на курс или консультацию</h2>
      <p class="muted" style="margin-bottom:28px;">Ответим в течение рабочего дня и расскажем про ближайший старт групп.</p>

      <% if (sent) { %>
        <div class="form-card" style="max-width:none;">
          <div class="form-success" style="display:block;">Спасибо! Заявка отправлена — мы свяжемся с вами в течение рабочего дня.</div>
          <a href="/account" class="btn btn-ghost" style="margin-top:18px;">Посмотреть мои заявки</a>
        </div>
      <% } else if (!currentUser) { %>
        <div class="form-card" style="max-width:none;">
          <p>Чтобы оставить заявку, войдите в личный кабинет или зарегистрируйтесь — это займёт минуту.</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/login?next=%2Fcontacts" class="btn btn-gold">Войти</a>
            <a href="/register" class="btn btn-ghost">Зарегистрироваться</a>
          </div>
        </div>
      <% } else { %>
        <div class="form-card" style="max-width:none;">
          <form method="post" action="/apply" data-lead-form>
            <div class="form-row"><label>Имя</label><input type="text" value="<%= currentUser.name %>" disabled></div>
            <div class="form-row"><label>Телефон</label><input type="text" value="<%= currentUser.phone %>" disabled></div>
            <div class="form-row">
              <label for="course">Интересующий курс</label>
              <select id="course" name="course">
                <% courses.forEach(function(c) { %><option><%= c.title %></option><% }); %>
                <option>Ещё не решил(а), нужна консультация</option>
              </select>
            </div>
            <div class="form-row">
              <label for="message">Комментарий (необязательно)</label>
              <textarea id="message" name="message" rows="3" placeholder="Удобное время, вопросы по курсу и т.д."></textarea>
            </div>
            <button type="submit" class="btn btn-gold" style="width:100%;justify-content:center;">Отправить заявку</button>
            <p class="form-note">Заявка появится в вашем личном кабинете и попадёт нашему менеджеру в Telegram.</p>
          </form>
        </div>
      <% } %>
    </div>

    <div>
      <h2 style="font-size:24px;">Как нас найти</h2>
      <div class="contact-info-item"><div class="ico">📍</div><div><h4>Адрес</h4><p><%= content.contacts.address %></p></div></div>
      <div class="contact-info-item"><div class="ico">📞</div><div><h4>Телефон</h4><p><%= content.contacts.phone %></p></div></div>
      <div class="contact-info-item"><div class="ico">✉️</div><div><h4>Email</h4><p><%= content.contacts.email %></p></div></div>
      <div class="contact-info-item"><div class="ico">🕒</div><div><h4>Часы работы</h4><p><%= content.contacts.hours %></p></div></div>
      <div class="contact-info-item"><div class="ico">💬</div><div><h4>Telegram</h4><p><%= content.contacts.telegram %></p></div></div>
      <div class="map-frame" style="margin-top:24px;">Карта — <%= content.contacts.address %></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
