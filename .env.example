# Скопируйте этот файл в .env и поменяйте значения (необязательно —
# сайт запустится и без .env, со значениями по умолчанию).

# Порт, на котором слушает сервер. Большинство Node.js-хостингов сами
# подставляют свой PORT через переменную окружения — трогать не нужно.
PORT=3000

# Секретный ключ для подписи сессионных cookie. Смените на что-то своё
# (любая длинная случайная строка) перед боевым запуском.
SESSION_SECRET=change-me-to-a-random-string
